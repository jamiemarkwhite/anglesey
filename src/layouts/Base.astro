---
import '../styles/global.css';
import Crab from '../components/Crab.astro';
import Chips from '../components/Chips.astro';
import Analytics from '../components/Analytics.astro';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { languages, locales, localePath, t, translationNote, type Locale } from '../i18n/ui';
import { editUiStringsUrl, posthogKey, repoUrl, suggestPlaceUrl } from '../site';
import homePhoto from '../assets/home.jpg';

interface Props {
  locale: Locale;
  // The page's address without a language prefix, e.g. `/places/moelfre`.
  path: string;
  title?: string;
  description?: string;
  // Shown when the page is shared on social media or in chat apps.
  image?: ImageMetadata;
  // Schema.org data for search engines, written out as JSON-LD.
  schema?: Record<string, unknown>;
  // Where to correct this page's Welsh text.
  translationUrl?: string;
  untranslated?: boolean;
}

const { locale, path, title, image, schema, translationUrl = editUiStringsUrl, untranslated = false } = Astro.props;
const strings = t(locale);
const description = Astro.props.description ?? strings.description;
const fullTitle = title ? `${title} · ${strings.titleSuffix}` : strings.homeTitle;
const note = untranslated ? translationNote.missing : translationNote.translated;
const absolute = (l: Locale) => new URL(localePath(l, path), Astro.site).href;
const canonical = absolute(locale);
const shareImage = image ?? homePhoto;
const ogImage = await getImage({ src: shareImage, width: 1200, format: 'jpg', quality: 75 });
const ogImageUrl = new URL(ogImage.src, Astro.site).href;
const ogImageHeight = Math.round((1200 * shareImage.height) / shareImage.width);
---

<!doctype html>
<html lang={languages[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={languages[l].htmlLang} href={absolute(l)} />)}
    <link rel="alternate" hreflang="x-default" href={absolute('en')} />
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={strings.titleSuffix} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={languages[locale].ogLocale} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta name="twitter:card" content="summary_large_image" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Archivo:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="wrap">
      <div class="topbar">
      <a class="top-crab" href={localePath(locale, '/crabbing')}><span aria-hidden="true">🦀</span> {strings.crabbingGuide.nav}</a>
      <nav class="lang" aria-label={strings.languageLabel}>
        {
          locales.map((l) => (
            <a
              href={localePath(l, path)}
              lang={languages[l].htmlLang}
              hreflang={l}
              aria-current={l === locale ? 'page' : undefined}
            >
              {languages[l].name}
            </a>
          ))
        }
      </nav>
      </div>
      {
        locale !== 'en' && (
          <p class="mt-note">
            {note.text} <a href={translationUrl} target="_blank" rel="noopener">{note.link}</a>
          </p>
        )
      }
      <slot />
      <footer class="footer">
        <p>{strings.footer} <a href="https://jamiewhite.dev" target="_blank" rel="noopener">Jamie White</a></p>
        <p>
          <a href={suggestPlaceUrl} target="_blank" rel="noopener">{strings.suggestPlace}</a> · <a href={repoUrl} target="_blank" rel="noopener">{strings.openSource}</a>
        </p>
        {posthogKey && <p class="privacy">{strings.privacy}</p>}
      </footer>
    </div>
    <Crab locale={locale} />
    <Chips locale={locale} />
    <Analytics />
  </body>
</html>
