---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Credit from '../components/Credit.astro';
import Photo from '../components/Photo.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { categories } from '../categories';
import homePhoto from '../assets/home.jpg';
import homeCredit from '../assets/home.json';

const places = await getCollection('places');
const boards = categories
  .map((category) => ({
    ...category,
    places: places
      .filter((p) => p.data.category === category.id)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((board) => board.places.length > 0);
---

<Base>
  <header class="masthead">
    <span class="tag">Ynys Môn guide</span>
    <h1 class="shadow">Anglesey</h1>
    <p class="lede">Beaches, castles, puffins and very good chips.</p>
    <Photo src={homePhoto} class="hero" widths={[720, 1280]} sizes="(max-width: 760px) 100vw, 720px" loading="eager" />
    <Credit credit={homeCredit} />
    <p class="intro">
      Anglesey (Ynys Môn in Welsh) is an island off the northwest coast of Wales, joined to the mainland by the
      Menai Suspension Bridge. Sandy beaches, clifftop walks, medieval castles and quirky family days out, from
      chasing puffins to fish and chips by the sea.
    </p>
    <p class="note">
      <strong>Heads up:</strong> some places close depending on weather and season. Don't always trust opening times
      on websites, and sometimes they're open when they say they aren't.
    </p>
  </header>

  <nav aria-label="Categories">
    <ul class="jump">
      {boards.map((b) => <li><a href={`#${b.id}`}>{b.name}</a></li>)}
      <li><a href="#shops">Shops</a></li>
    </ul>
  </nav>

  {
    boards.map((b) => (
      <section class="section" id={b.id}>
        <h2>{b.name}</h2>
        <ul class="cards">
          {b.places.map((p) => (
            <PlaceCard place={p} />
          ))}
        </ul>
      </section>
    ))
  }

  <section class="section prose" id="shops">
    <h2>Supermarkets &amp; shops</h2>
    <p>
      All the big supermarkets are in <strong>Llangefni</strong> (ASDA, Lidl, Aldi) and <strong>Holyhead</strong>.
      Cross the bridge to Bangor for Tesco. If you're desperate for a McDonald's, head to Bangor or Holyhead.
    </p>
    <p>
      There are Premier convenience stores in <strong>Bethel</strong> and <strong>Newborough</strong> on the south of
      the island. Both will soon have walk-in beer chillers for cold beers on the beach.
    </p>
  </section>

  <section class="section prose" id="other-guides">
    <h2>Other guides</h2>
    <ul>
      <li><a href="https://www.visitanglesey.co.uk">Visit Anglesey</a> - official tourism site</li>
      <li>
        <a href="https://www.dayoutwiththekids.co.uk/things-to-do/north-wales/isle-of-anglesey/anglesey">Day Out With The Kids</a>
        - family activities
      </li>
    </ul>
  </section>
</Base>
