---
import { getCollection } from 'astro:content';
import PlaceRow from '../components/PlaceRow.astro';
import Base from '../layouts/Base.astro';
import { categories } from '../categories';

const places = await getCollection('places');
const boards = categories
  .map((category) => ({
    ...category,
    places: places
      .filter((p) => p.data.category === category.id)
      .sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((board) => board.places.length > 0);
---

<Base>
  <header>
    <h1>Anglesey</h1>
    <p class="intro">
      Welcome to Anglesey (Ynys Môn in Welsh), an island off the northwest coast of Wales joined to the
      mainland by the Menai Suspension Bridge. Sandy beaches, clifftop walks, medieval castles and
      quirky family days out, from chasing puffins to fish and chips by the sea.
    </p>
    <p class="note">
      <strong>Heads up:</strong> some places close depending on weather and season. Don't always trust
      opening times on websites, and sometimes they're open when they say they aren't.
    </p>
  </header>

  <nav aria-label="Categories">
    <ul class="jump">
      {boards.map((b) => <li><a href={`#${b.id}`}>{b.emoji} {b.name}</a></li>)}
      <li><a href="#shops">🛒 Shops</a></li>
    </ul>
  </nav>

  {
    boards.map((b) => (
      <section class="board" id={b.id}>
        <h2>{b.name}</h2>
        <ul class="rows">
          {b.places.map((p) => (
            <PlaceRow place={p} />
          ))}
        </ul>
      </section>
    ))
  }

  <section class="board prose" id="shops">
    <h2>Supermarkets &amp; shops</h2>
    <p>
      All the big supermarkets are in <strong>Llangefni</strong> (ASDA, Lidl, Aldi) and <strong>Holyhead</strong>.
      Cross the bridge to Bangor for Tesco. If you're desperate for a McDonald's, head to Bangor or Holyhead.
    </p>
    <p>
      There are Premier convenience stores in <strong>Bethel</strong> and <strong>Newborough</strong> on the
      south of the island. Both will soon have walk-in beer chillers for cold beers on the beach 🏖️
    </p>
  </section>

  <section class="board prose" id="other-guides">
    <h2>Other guides</h2>
    <ul>
      <li><a href="https://www.visitanglesey.co.uk">Visit Anglesey</a> - official tourism site</li>
      <li>
        <a href="https://www.dayoutwiththekids.co.uk/things-to-do/north-wales/isle-of-anglesey/anglesey">Day Out With The Kids</a>
        - family activities
      </li>
    </ul>
  </section>
</Base>
