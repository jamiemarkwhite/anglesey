---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Credit from '../../components/Credit.astro';
import Photo from '../../components/Photo.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import { getCategory } from '../../categories';
import { editPlaceUrl } from '../../site';

export async function getStaticPaths() {
  const places = await getCollection('places');
  return places.map((place) => ({
    params: { slug: place.id },
    props: { place, nearby: places.filter((p) => p.data.area === place.data.title) },
  }));
}

const { place, nearby } = Astro.props;
const { Content } = await render(place);
const category = getCategory(place.data.category);
---

<Base title={place.data.title} description={place.data.summary}>
  <a class="back" href={`/#${category.id}`}>← {category.name}</a>
  <article>
    <span class="tag">{category.name}{place.data.area && ` · ${place.data.area}`}</span>
    <h1 class="shadow place-title">{place.data.title}</h1>
    <p class="lede">{place.data.summary}</p>
    <Photo
      src={place.data.photo}
      emoji={place.data.emoji}
      class="hero"
      widths={[720, 1280]}
      sizes="(max-width: 760px) 100vw, 720px"
      loading="eager"
    />
    <Credit credit={place.data.credit} />
    <div class="prose body"><Content /></div>
    {
      nearby.length > 0 && (
        <section class="section">
          <h2>In {place.data.title}</h2>
          <ul class="cards">
            {nearby.map((p) => (
              <PlaceCard place={p} />
            ))}
          </ul>
        </section>
      )
    }
    <p class="actions">
      <a class="button" href={place.data.url} rel="noopener">Website ↗</a>
      <a class="edit" href={editPlaceUrl(place.id)}>Something out of date? Edit this page</a>
    </p>
  </article>
</Base>
