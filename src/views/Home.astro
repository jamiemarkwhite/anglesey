---
import Base from '../layouts/Base.astro';
import Credit from '../components/Credit.astro';
import Photo from '../components/Photo.astro';
import PlaceCard from '../components/PlaceCard.astro';
import PlaceMap from '../components/PlaceMap.astro';
import CrabArt from '../components/CrabArt.astro';
import { categoryIds } from '../categories';
import { categoryNames, languages, localePath, t, type Locale } from '../i18n/ui';
import { getPlaces } from '../i18n/places';
import homePhoto from '../assets/home.jpg';
import homeCredit from '../assets/home.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const places = await getPlaces(locale);
const boards = categoryIds
  .map((id) => ({
    id,
    name: categoryNames[locale][id],
    places: places.filter((p) => p.data.category === id).sort((a, b) => a.data.order - b.data.order),
  }))
  .filter((board) => board.places.length > 0);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: strings.titleSuffix,
  url: new URL(localePath(locale, '/'), Astro.site).href,
  description: strings.description,
  inLanguage: languages[locale].htmlLang,
};
const featured = places.filter((p) => p.data.featured).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<Base locale={locale} path="/" schema={schema}>
  <header class="masthead">
    <span class="tag">{strings.tag}</span>
    <h1 class="shadow">{strings.siteName}</h1>
    <p class="lede">{strings.lede}</p>
    <Photo src={homePhoto} class="hero" widths={[720, 1280]} sizes="(max-width: 1200px) 100vw, 1168px" loading="eager" />
    <Credit credit={homeCredit} locale={locale} />
    <p class="intro">{strings.intro}</p>
    <p class="note">
      <strong>{strings.headsUpLabel}</strong>
      {strings.headsUp}
    </p>
  </header>

  <a class="crab-feature" href={localePath(locale, '/crabbing')}>
    <div class="crab-feature-text">
      <span class="tag">🦀 {strings.crabbingGuide.featureTag}</span>
      <h2>{strings.crabbingGuide.title}</h2>
      <p>{strings.crabbingGuide.featureLede}</p>
      <ol>
        {strings.crabbingGuide.steps.slice(0, 4).map((step) => <li>{step.title}</li>)}
        <li>…</li>
      </ol>
      <span class="button">{strings.crabbingGuide.cta} →</span>
    </div>
    <div class="crab-feature-art">
      <CrabArt scene="net" />
      <CrabArt scene="bacon" />
    </div>
  </a>

  {
    featured.length > 0 && (
      <section class="section" id="featured">
        <h2>{strings.featuredHeading}</h2>
        <ul class="cards featured">
          {featured.map((p) => (
            <PlaceCard place={p} locale={locale} />
          ))}
        </ul>
      </section>
    )
  }

  <PlaceMap places={places} locale={locale} />

  <h2 class="things-heading" id="things-to-do">{strings.thingsHeading}</h2>
  <nav aria-label={strings.categoriesLabel}>
    <ul class="jump">
      {boards.map((b) => <li><a href={`#${b.id}`}>{b.name}</a></li>)}
      <li><a href="#shops">{strings.shopsNav}</a></li>
    </ul>
  </nav>

  {
    boards.map((b) => (
      <section class="section" id={b.id}>
        <h2>{b.name}</h2>
        <ul class="cards">
          {b.places.map((p) => (
            <PlaceCard place={p} locale={locale} />
          ))}
        </ul>
      </section>
    ))
  }

  <section class="section parkrun" id="parkrun">
    <h2><span aria-hidden="true">🏃</span> {strings.parkrunHeading}</h2>
    <p set:html={strings.parkrunIntro} />
    <div class="parkrun-list">
      {
        strings.parkruns.map((r) => (
          <div class="parkrun-item">
            <h3><a href={r.href}>{r.name}</a></h3>
            <p>{r.html}</p>
            <a class="parkrun-site" href={r.site} target="_blank" rel="noopener">parkrun.org.uk ↗</a>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section prose" id="shops">
    <h2>{strings.shopsHeading}</h2>
    {strings.shopsHtml.map((html) => <p set:html={html} />)}
  </section>

  <section class="section prose rnli" id="rnli">
    <h2><span aria-hidden="true">🛟</span> {strings.rnliHeading}</h2>
    {strings.rnliHtml.map((html) => <p set:html={html} />)}
  </section>

  <section class="section prose" id="other-guides">
    <h2>{strings.otherGuidesHeading}</h2>
    <ul>
      <li><a href="https://www.visitanglesey.co.uk" target="_blank" rel="noopener">Visit Anglesey</a> - {strings.visitAnglesey}</li>
      <li><a href="https://www.visitwales.com/destinations/north-wales/isle-anglesey" target="_blank" rel="noopener">Visit Wales</a> - {strings.visitWales}</li>
      <li><a href="https://www.walescoastpath.gov.uk/where-to-walk/isle-of-anglesey/" target="_blank" rel="noopener">Wales Coast Path</a> - {strings.coastPath}</li>
      <li>
        <a href="https://www.dayoutwiththekids.co.uk/things-to-do/north-wales/isle-of-anglesey/anglesey" target="_blank" rel="noopener">Day Out With The Kids</a>
        - {strings.dayOut}
      </li>
    </ul>
  </section>
</Base>
