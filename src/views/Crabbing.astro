---
import Base from '../layouts/Base.astro';
import CrabArt, { type Scene } from '../components/CrabArt.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { localePath, t, type Locale } from '../i18n/ui';
import { getPlaces } from '../i18n/places';
import { tideTableUrl } from '../activities';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);
const guide = strings.crabbingGuide;
const spots = (await getPlaces(locale))
  .filter((p) => p.data.activities.includes('crabbing'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const tides = spots
  .filter((p) => p.data.tides)
  .map((p) => ({ place: p.data.title, href: tideTableUrl(p.data.tides!) }));
---

<Base locale={locale} path="/crabbing" title={guide.title} description={guide.description}>
  <p><a class="back" href={localePath(locale, '/')}>← {strings.siteName}</a></p>
  <span class="tag">🦀 {guide.nav}</span>
  <h1 class="shadow place-title">{guide.title}</h1>
  <p class="lede">{guide.intro}</p>

  <ol class="crab-steps">
    {
      guide.steps.map((step, i) => (
        <li>
          <CrabArt scene={step.scene as Scene} />
          <div>
            <h2>
              <span class="step-no">{i + 1}</span> {step.title}
            </h2>
            <p set:html={step.html} />
            {
              step.scene === 'tide' && (
                <p class="tide-label">{guide.tidesLabel}</p>
              )
            }
            {
              step.scene === 'tide' && (
                <ul class="tide-links">
                  {tides.map((tide) => (
                    <li>
                      <a href={tide.href} target="_blank" rel="noopener">
                        {tide.place} ↗
                      </a>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </li>
      ))
    }
  </ol>

  <section class="section">
    <h2>{guide.spotsHeading}</h2>
    <ul class="cards">
      {spots.map((p) => <PlaceCard place={p} locale={locale} />)}
    </ul>
  </section>
</Base>

<style>
  .crab-steps {
    list-style: none;
    padding: 0;
    margin: 28px 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 18px;
  }
  .crab-steps > li {
    border: 3px solid var(--blue);
    box-shadow: 5px 5px 0 var(--yellow);
    background: #fff;
    padding: 18px 20px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .crab-steps :global(.crab-art) {
    margin: 0 auto;
    max-width: 180px;
  }
  .crab-steps h2 {
    margin: 0;
    font-size: 21px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .step-no {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: var(--blue);
    color: #fff;
    font-size: 15px;
  }
  .crab-steps .tide-label {
    margin: 12px 0 0;
    font-weight: 700;
  }
  .tide-links {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
    display: grid;
    gap: 6px;
  }
  .tide-links a {
    font-weight: 700;
    font-size: 14px;
  }
  .crab-steps p {
    margin: 6px 0 0;
  }
</style>
