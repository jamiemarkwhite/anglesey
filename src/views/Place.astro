---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Credit from '../components/Credit.astro';
import Photo from '../components/Photo.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { categoryNames, localePath, t, type Locale } from '../i18n/ui';
import type { LocalizedPlace } from '../i18n/places';
import { tideStations, tideTableUrl } from '../activities';
import { editPlaceTranslationUrl, editPlaceUrl, newPlaceTranslationUrl } from '../site';

interface Props {
  locale: Locale;
  place: LocalizedPlace;
  town?: LocalizedPlace;
  nearby: LocalizedPlace[];
}

const { locale, place, town, nearby } = Astro.props;
const strings = t(locale);
const { Content } = await render(place.entry);
const category = place.data.category;
const categoryName = categoryNames[locale][category];
const translationUrl = place.translated ? editPlaceTranslationUrl(place.id) : newPlaceTranslationUrl(place.id);
const editUrl = locale === 'en' ? editPlaceUrl(place.id) : translationUrl;
---

<Base
  locale={locale}
  path={`/places/${place.id}`}
  title={place.data.title}
  description={place.data.summary}
  translationUrl={translationUrl}
  untranslated={!place.translated}
>
  <a class="back" href={localePath(locale, `/#${category}`)}>← {categoryName}</a>
  <article lang={place.translated ? undefined : 'en-GB'}>
    <span class="tag">{categoryName}{town && ` · ${town.data.title}`}</span>
    <h1 class="shadow place-title">{place.data.title}</h1>
    <p class="lede">{place.data.summary}</p>
    <Photo
      src={place.data.photo}
      emoji={place.data.emoji}
      class="hero"
      widths={[720, 1280]}
      sizes="(max-width: 1200px) 100vw, 1168px"
      loading="eager"
    />
    <Credit credit={place.data.credit} locale={locale} />
    <div class="prose body"><Content /></div>
    {
      nearby.length > 0 && (
        <section class="section">
          <h2>{strings.inArea(place.data.title)}</h2>
          <ul class="cards">
            {nearby.map((p) => (
              <PlaceCard place={p} locale={locale} />
            ))}
          </ul>
        </section>
      )
    }
    <p class="actions">
      <a class="button" href={place.data.url} rel="noopener">{strings.website} ↗</a>
      {
        place.data.tides && (
          <a class="button" href={tideTableUrl(place.data.tides)} rel="noopener">
            {strings.tideTimes(tideStations[place.data.tides])} ↗
          </a>
        )
      }
      <a class="edit" href={editUrl}>{strings.editPrompt}</a>
    </p>
  </article>
</Base>
