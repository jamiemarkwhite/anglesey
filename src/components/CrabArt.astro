---
export type Scene = 'bucket' | 'net' | 'tide' | 'stones' | 'sink' | 'bacon' | 'hold' | 'pier';

interface Props {
  scene: Scene;
}

const { scene } = Astro.props;
const ink = '#0b1f5c';
const red = '#e5332a';
---

<svg class="crab-art" viewBox="0 0 160 120" aria-hidden="true">
  <defs>
    <g id={`crab-${scene}`}>
      <g stroke={ink} stroke-width="3" stroke-linecap="square" fill="none">
        <path d="M22 46 L12 56" /><path d="M26 49 L18 60" /><path d="M31 51 L26 62" />
        <path d="M62 46 L72 56" /><path d="M58 49 L66 60" /><path d="M53 51 L58 62" />
      </g>
      <g stroke={ink} stroke-width="2.5" stroke-linejoin="round">
        <path d="M20 38 L12 28" fill="none" />
        <path d="M4 26 Q4 14 14 14 L16 24 Z" fill={red} />
        <path d="M14 14 Q22 12 20 22 L16 24 Z" fill={red} />
        <path d="M64 38 L72 28" fill="none" />
        <path d="M80 26 Q80 14 70 14 L68 24 Z" fill={red} />
        <path d="M70 14 Q62 12 64 22 L68 24 Z" fill={red} />
        <path d="M35 34 L33 22 M49 34 L51 22" />
      </g>
      <rect x="18" y="32" width="48" height="20" rx="4" fill={red} stroke={ink} stroke-width="2.5" />
      <rect x="24" y="44" width="5" height="3" fill="#ffb3a8" /><rect x="55" y="44" width="5" height="3" fill="#ffb3a8" />
      <path d="M37 41 Q42 47 47 41" fill="none" stroke={ink} stroke-width="2" stroke-linecap="round" />
      <rect x="27" y="13" width="12" height="12" rx="2" fill="#fff" stroke={ink} stroke-width="2.5" />
      <rect x="31" y="17" width="4.5" height="4.5" fill={ink} />
      <rect x="45" y="13" width="12" height="12" rx="2" fill="#fff" stroke={ink} stroke-width="2.5" />
      <rect x="49" y="17" width="4.5" height="4.5" fill={ink} />
    </g>
  </defs>

  {
    scene === 'bucket' && (
      <g>
        <use href={`#crab-${scene}`} transform="translate(38 30) scale(1)" />
        <path d="M40 58 L120 58 L110 112 L50 112 Z" fill="rgba(170,200,255,.45)" stroke={ink} stroke-width="3" stroke-linejoin="round" />
        <path d="M40 58 Q80 20 120 58" fill="none" stroke={ink} stroke-width="2.5" />
        <path d="M46 72 L114 72" stroke="#1239c6" stroke-width="2" stroke-dasharray="6 5" />
      </g>
    )
  }
  {
    scene === 'net' && (
      <g>
        <ellipse cx="80" cy="96" rx="62" ry="16" fill="#e8edff" stroke={ink} stroke-width="3" />
        <path d="M24 92 L136 92 M30 100 L130 100 M40 86 L120 86 M50 82 L50 110 M70 80 L70 112 M90 80 L90 112 M110 82 L110 110" stroke="#1239c6" stroke-width="1.5" />
        <use href={`#crab-${scene}`} transform="translate(38 36)" />
        <path d="M18 92 L80 10 L142 92" fill="none" stroke={ink} stroke-width="2" stroke-dasharray="3 4" />
      </g>
    )
  }
  {
    scene === 'tide' && (
      <g>
        <use href={`#crab-${scene}`} transform="translate(38 22)" />
        <path d="M0 92 Q20 80 40 92 T80 92 T120 92 T160 92 V120 H0 Z" fill="#1239c6" />
        <path d="M0 102 Q20 90 40 102 T80 102 T120 102 T160 102" fill="none" stroke="#fff" stroke-width="2.5" />
        <path d="M134 14 L134 50 M126 22 L134 14 L142 22" fill="none" stroke={ink} stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    scene === 'stones' && (
      <g>
        <path d="M30 40 L130 40 L118 112 L42 112 Z" fill="rgba(170,200,255,.45)" stroke={ink} stroke-width="3" stroke-linejoin="round" />
        <path d="M34 62 L126 62" stroke="#1239c6" stroke-width="2" stroke-dasharray="6 5" />
        <ellipse cx="60" cy="102" rx="14" ry="8" fill="#9aa4bd" stroke={ink} stroke-width="2.5" />
        <ellipse cx="88" cy="104" rx="12" ry="7" fill="#c3c9d8" stroke={ink} stroke-width="2.5" />
        <ellipse cx="104" cy="96" rx="9" ry="6" fill="#9aa4bd" stroke={ink} stroke-width="2.5" />
        <use href={`#crab-${scene}`} transform="translate(56 54) scale(.55)" />
      </g>
    )
  }
  {
    scene === 'sink' && (
      <g>
        <rect x="0" y="0" width="160" height="120" fill="#e8edff" />
        <path d="M80 0 L80 70" stroke={ink} stroke-width="2" />
        <ellipse cx="80" cy="96" rx="56" ry="12" fill="#fff" stroke={ink} stroke-width="3" />
        <path d="M30 92 L130 92 M44 100 L116 100" stroke="#1239c6" stroke-width="1.5" />
        <ellipse cx="80" cy="86" rx="20" ry="12" fill="#9aa4bd" stroke={ink} stroke-width="2.5" />
        <path d="M26 96 L80 70 L134 96" fill="none" stroke={ink} stroke-width="1.5" />
        <path d="M12 116 L148 116" stroke="#c9b37a" stroke-width="6" />
      </g>
    )
  }
  {
    scene === 'bacon' && (
      <g>
        <use href={`#crab-${scene}`} transform="translate(16 44)" />
        <g transform="rotate(-12 124 40)">
          <path d="M92 30 C102 22 110 38 120 30 S138 22 150 30 L150 50 C138 42 130 58 120 50 S102 42 92 50 Z" fill="#f2998d" stroke={ink} stroke-width="2.5" stroke-linejoin="round" />
          <path d="M92 40 C102 32 110 48 120 40 S138 32 150 40" fill="none" stroke="#fff" stroke-width="4" />
          <path d="M92 36 C102 28 110 44 120 36 S138 28 150 36" fill="none" stroke="#c9564a" stroke-width="1.5" />
        </g>
        <path d="M112 84 l5 -9 l5 9 M128 90 l5 -9 l5 9" fill="none" stroke="#ffd400" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    scene === 'hold' && (
      <g>
        <use href={`#crab-${scene}`} transform="translate(38 52)" />
        <path d="M150 0 L104 0 L84 72 Q82 80 74 78 L66 76 L64 84 L100 88 Q112 88 116 76 Z" fill="#ffd9b8" stroke={ink} stroke-width="2.5" stroke-linejoin="round" />
        <path d="M96 70 Q104 70 108 82 M86 66 Q94 64 98 76" fill="none" stroke={ink} stroke-width="2" stroke-linecap="round" />
        <path d="M20 26 l8 8 l16 -18" fill="none" stroke="#1239c6" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    )
  }
  {
    scene === 'pier' && (
      <g>
        <path d="M0 70 L160 70" stroke={ink} stroke-width="5" />
        <path d="M20 70 L20 120 M60 70 L60 120 M100 70 L100 120 M140 70 L140 120" stroke={ink} stroke-width="4" />
        <path d="M0 96 Q20 88 40 96 T80 96 T120 96 T160 96 V120 H0 Z" fill="#1239c6" opacity=".85" />
        <use href={`#crab-${scene}`} transform="translate(60 40) scale(.62)" />
        <path d="M18 22 q8 -8 16 0 q8 -8 16 0" fill="none" stroke={ink} stroke-width="2.5" stroke-linecap="round" />
        <circle cx="34" cy="40" r="3" fill="#fff" stroke={ink} stroke-width="1.5" />
        <circle cx="36" cy="52" r="2.5" fill="#fff" stroke={ink} stroke-width="1.5" />
        <path d="M118 30 l14 -10 M122 40 l18 -4" stroke="#9aa4bd" stroke-width="2.5" stroke-linecap="round" />
      </g>
    )
  }
</svg>

<style>
  .crab-art {
    display: block;
    width: 100%;
    height: auto;
    max-width: 200px;
  }
</style>
