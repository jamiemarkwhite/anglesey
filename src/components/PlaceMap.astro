---
import { activityEmoji, activityIds, tideStations, tideTableUrl } from '../activities';
import { activityNames, localePath, t, type Locale } from '../i18n/ui';
import type { LocalizedPlace } from '../i18n/places';

interface Props {
  places: LocalizedPlace[];
  locale: Locale;
}

const { places, locale } = Astro.props;
const strings = t(locale);
const used = activityIds.filter((id) => places.some((p) => p.data.activities.includes(id)));
const pins = places.map((p) => ({
  title: p.data.title,
  tagline: p.data.tagline,
  emoji: p.data.emoji,
  lat: p.data.lat,
  lng: p.data.lng,
  href: localePath(locale, `/places/${p.id}`),
  activities: p.data.activities,
  tides: p.data.tides && { label: strings.tideTimes(tideStations[p.data.tides]), href: tideTableUrl(p.data.tides) },
}));
---

<section class="section" id="map-section">
  <h2>{strings.mapHeading}</h2>
  <div class="filter" role="group" aria-label={strings.filterLabel} hidden>
    <button type="button" data-activity="" aria-pressed="true">{strings.allActivities}</button>
    {
      used.map((id) => (
        <button type="button" data-activity={id} aria-pressed="false">
          <span aria-hidden="true">{activityEmoji[id]}</span> {activityNames[locale][id]}
        </button>
      ))
    }
  </div>
  <div class="map" role="region" aria-label={strings.mapLabel} data-pins={JSON.stringify(pins)}></div>
  <svg class="map-filter" aria-hidden="true" focusable="false">
    <filter id="riso-tiles" color-interpolation-filters="sRGB">
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncR type="table" tableValues="0.071 1" />
        <feFuncG type="table" tableValues="0.224 1" />
        <feFuncB type="table" tableValues="0.776 1" />
      </feComponentTransfer>
    </filter>
  </svg>
  <p class="no-matches" hidden>{strings.noMatches}</p>
</section>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  interface Pin {
    title: string;
    tagline: string;
    emoji: string;
    lat: number;
    lng: number;
    href: string;
    activities: string[];
    tides?: { label: string; href: string };
  }

  const el = document.querySelector<HTMLElement>('.map');
  const filter = document.querySelector<HTMLElement>('.filter');

  if (el && filter) {
    const pins: Pin[] = JSON.parse(el.dataset.pins ?? '[]');
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
    }).addTo(map);

    const escape = (text: string) =>
      text.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

    const markers = pins.map((pin) => {
      const icon = L.divIcon({ className: 'pin', html: `<span>${pin.emoji}</span>`, iconSize: [36, 36] });
      const tides = pin.tides ? `<a href="${pin.tides.href}" target="_blank" rel="noopener">${escape(pin.tides.label)} ↗</a>` : '';
      const marker = L.marker([pin.lat, pin.lng], { icon, title: pin.title, alt: pin.title }).bindPopup(
        `<a class="pin-title" href="${pin.href}">${escape(pin.title)}</a><span>${escape(pin.tagline)}</span>${tides}`,
      );
      return { pin, marker };
    });

    const cards = [...document.querySelectorAll<HTMLElement>('.card[data-activities]')];
    const sections = [...document.querySelectorAll<HTMLElement>('.section')].filter((s) =>
      s.querySelector('.card[data-activities]'),
    );
    const noMatches = document.querySelector<HTMLElement>('.no-matches');
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>('button')];

    function show(activity: string) {
      const matches = (list: string[]) => !activity || list.includes(activity);
      const visible = markers.filter(({ pin }) => matches(pin.activities));
      for (const { marker } of markers) marker.remove();
      for (const { marker } of visible) marker.addTo(map);
      // Frame the island; off-island day trips stay on the map but don't widen the view.
      const onIsland = visible.filter(({ pin }) => pin.lat >= 53.1 && pin.lng <= -3.9);
      const framed = onIsland.length > 0 ? onIsland : visible;
      if (framed.length > 0) {
        map.fitBounds(L.latLngBounds(framed.map(({ pin }) => [pin.lat, pin.lng])), { padding: [36, 36], maxZoom: 13 });
      }
      for (const card of cards) card.hidden = !matches((card.dataset.activities ?? '').split(' '));
      for (const section of sections) {
        section.hidden = !section.querySelector('.card:not([hidden])');
        const jump = document.querySelector(`.jump a[href="#${section.id}"]`)?.parentElement;
        if (jump) jump.hidden = section.hidden;
      }
      if (noMatches) noMatches.hidden = visible.length > 0;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.activity === activity));

      const url = new URL(location.href);
      if (activity) url.searchParams.set('activity', activity);
      else url.searchParams.delete('activity');
      history.replaceState(null, '', url);
    }

    for (const b of buttons) b.addEventListener('click', () => show(b.dataset.activity ?? ''));

    const requested = new URLSearchParams(location.search).get('activity') ?? '';
    filter.hidden = false;
    show(buttons.some((b) => b.dataset.activity === requested) ? requested : '');
  }
</script>
