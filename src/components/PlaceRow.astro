---
import type { CollectionEntry } from 'astro:content';

interface Props {
  place: CollectionEntry<'places'>;
}

const { place } = Astro.props;
---

<li>
  <a href={`/places/${place.id}`}>
    <span aria-hidden="true">{place.data.emoji}</span>
    <span class="name">{place.data.title}</span>
    <i class="dots" aria-hidden="true"></i>
    <span class="tag">{place.data.tagline}</span>
  </a>
</li>
