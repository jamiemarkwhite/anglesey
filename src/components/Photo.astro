---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  widths = [400, 800],
  sizes = '(max-width: 720px) 100vw, 240px',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<div class:list={['duo', className, { empty: !src }]}>
  {src && <Image src={src} alt="" widths={widths} sizes={sizes} loading={loading} quality={70} />}
</div>
