---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  src?: ImageMetadata;
  emoji?: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const {
  src,
  emoji,
  widths = [400, 800],
  sizes = '(max-width: 600px) 100vw, (max-width: 1200px) 50vw, 580px',
  class: className,
  loading = 'lazy',
} = Astro.props;
---

<div class:list={['duo', className]}>
  {src && <Image src={src} alt="" widths={widths} sizes={sizes} loading={loading} quality={70} />}
  {!src && emoji && <span class="duo-emoji" aria-hidden="true">{emoji}</span>}
</div>
