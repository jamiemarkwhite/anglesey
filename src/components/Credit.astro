---
import type { z } from 'astro/zod';
import type { credit as creditSchema } from '../content.config';
import { t, type Locale } from '../i18n/ui';

interface Props {
  credit?: z.infer<typeof creditSchema>;
  locale: Locale;
}

const { credit, locale } = Astro.props;
---

{
  credit && (
    <p class="credit">
      {t(locale).photo} {credit.source ? <a href={credit.source}>{credit.author}</a> : credit.author},{' '}
      {credit.licenseUrl ? <a href={credit.licenseUrl}>{credit.license}</a> : credit.license}
    </p>
  )
}
